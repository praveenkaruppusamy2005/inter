{
  "headers": [
    {
      "source": "/SecureWebView-Setup.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"SecureWebView-Setup.exe\""
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
